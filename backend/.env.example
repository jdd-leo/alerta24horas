# Banco (docker-compose sobe o Postgres na porta 5434)
DATABASE_URL="postgresql://alerta:alerta@localhost:5434/alerta24horas?schema=public"

# Porta da API
PORT=3333

# Segredo do JWT emitido pela API
JWT_SECRET="troque-este-segredo"

# Google OAuth: Client ID (web) usado para verificar o idToken do frontend
GOOGLE_CLIENT_ID=""

# Diretório onde as fotos das sinalizações são salvas
UPLOAD_DIR="uploads"

# URL pública da API (usada para montar as URLs das fotos)
PUBLIC_BASE_URL="http://localhost:3333"

# Origem permitida no CORS (frontend)
CORS_ORIGIN="http://localhost:5173"

# Ativa o login de desenvolvimento (POST /api/auth/dev-login) sem Google. Nunca use em produção.
DEV_AUTH=true
