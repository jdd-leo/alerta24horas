generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  picture   String?
  createdAt DateTime @default(now())

  signals Signal[]
  floods  Flood[]
}

model Signal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  emoji       String
  title       String
  description String
  photos      String[]
  lat         Float
  lng         Float
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  deletedAt   DateTime?

  @@index([expiresAt])
  @@index([deletedAt])
  @@index([userId])
}

enum FloodLevel {
  LOW
  MEDIUM
  HIGH
}

model Flood {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  level     FloodLevel
  lat       Float
  lng       Float
  createdAt DateTime   @default(now())
  expiresAt DateTime
  deletedAt DateTime?

  @@index([expiresAt])
  @@index([deletedAt])
  @@index([userId])
}
